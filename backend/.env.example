PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
EMAIL_MODE=preview
EMAIL_FROM="Ndia TVC Communication Portal <no-reply@ndiatvc.ac.ke>"

# Set EMAIL_MODE=smtp to send real email.
# Example Gmail/Google Workspace SMTP settings:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
